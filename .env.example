# ==========================================
# HealthBridge — Master Environment Configuration Template
# ==========================================
# Copy relevant sections to backend/.env, ai-service/.env, and frontend/.env

# ------------------------------------------
# 1. Express REST API Backend (backend/.env)
# ------------------------------------------
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/healthbridge
CLIENT_URL=http://localhost:5173

# Authentication & JWT Configuration
JWT_SECRET=replace-with-a-secure-random-jwt-secret-min-32-chars
JWT_EXPIRES_IN=1h

# AI Service Gateway Integration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET_KEY=hb_internal_secret_key_change_in_production_32char

# AI Rate Limiting & RAG Configuration
AI_RAG_MIN_SIMILARITY=0.55
AI_ASSISTANT_RATE_LIMIT_MAX=30
AI_ASSISTANT_RATE_LIMIT_WINDOW_MS=60000

# Clinical Tool Calling Safety Bounds
AI_TOOL_CALL_MAX=2
AI_TOOL_RESULT_MAX_ITEMS=50
AI_TOOL_EXECUTION_TIMEOUT_MS=5000

# Clinical Agent Orchestration Safety Bounds
AI_AGENT_MAX_STEPS=4
AI_AGENT_MAX_TOOL_CALLS=4
AI_AGENT_MAX_CONTEXT_ITEMS=100
AI_AGENT_TIMEOUT_MS=15000

# ------------------------------------------
# 2. FastAPI AI Microservice (ai-service/.env)
# ------------------------------------------
# Microservice Networking & Security
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0
FASTAPI_ENV=development
INTERNAL_SERVICE_KEY=hb_internal_secret_key_change_in_production_32char

# Embedding Provider: 'mock' (local/offline) or 'openai'
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# LLM Provider: 'mock' (deterministic synthetic) or 'openai'
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
RAG_MIN_SIMILARITY=0.55
VECTOR_STORE=memory

# OpenAI API Key (Required ONLY if EMBEDDING_PROVIDER=openai or LLM_PROVIDER=openai)
OPENAI_API_KEY=

# ------------------------------------------
# 3. React Frontend (frontend/.env)
# ------------------------------------------
VITE_API_URL=http://localhost:5000
