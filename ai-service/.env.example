# HealthBridge AI Microservice Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Internal Service Authentication Key (shared between Express Backend and AI Service)
INTERNAL_SERVICE_KEY=hb_internal_secret_key_change_in_production_32char

# Embedding Provider: 'mock' (deterministic, local, zero-dependency) or 'openai'
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# LLM Provider: 'mock' (deterministic, local, zero-dependency) or 'openai'
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
RAG_MIN_SIMILARITY=0.55

# Vector Store: 'memory' (in-memory cosine similarity with tenant metadata filtering)
VECTOR_STORE=memory

# OpenAI API Key (Required ONLY if EMBEDDING_PROVIDER=openai or LLM_PROVIDER=openai)
OPENAI_API_KEY=
