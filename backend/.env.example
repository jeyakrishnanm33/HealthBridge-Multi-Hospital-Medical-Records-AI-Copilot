# HealthBridge Express Backend Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/healthbridge
CLIENT_URL=http://localhost:5173

# Authentication & JWT Configuration
JWT_SECRET=replace-with-a-secure-random-jwt-secret-min-32-chars
JWT_EXPIRES_IN=1h

# AI Microservice Gateway Settings
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET_KEY=hb_internal_secret_key_change_in_production_32char
AI_RAG_MIN_SIMILARITY=0.55
AI_ASSISTANT_RATE_LIMIT_MAX=30
AI_ASSISTANT_RATE_LIMIT_WINDOW_MS=60000

# Safety Guardrails & Resource Limits
AI_TOOL_CALL_MAX=2
AI_TOOL_RESULT_MAX_ITEMS=50
AI_TOOL_EXECUTION_TIMEOUT_MS=5000
AI_AGENT_MAX_STEPS=4
AI_AGENT_MAX_TOOL_CALLS=4
AI_AGENT_MAX_CONTEXT_ITEMS=100
AI_AGENT_TIMEOUT_MS=15000
